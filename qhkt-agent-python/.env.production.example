APP_ENV=production
HOST=0.0.0.0
PORT=8094
DATABASE_URL=
DB_AUTO_CREATE=false

AI_ENABLED=true
AI_BASE_URL=https://api.weixungz.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-5.4
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_TOOL_CALLS=4
AI_FALLBACK_ENABLED=true
AGENT_RUNTIME=langgraph
MAX_GRAPH_STEPS=12
GRAPH_NODE_TIMEOUT_SECONDS=45
GRAPH_CHECKPOINT_TTL_SECONDS=604800
MEMORY_CONTEXT_TOKEN_LIMIT=1000

JWT_ENABLED=true
JWT_JWKS_URL=http://qhkt-auth:8081/jwks/set
JWT_ISSUER=
JWT_AUDIENCE=
TRUST_GATEWAY_HEADERS=false

COURSE_SERVICE_URL=http://qhkt-course:8086
LEARNING_SERVICE_URL=http://qhkt-learning:8090
EXAM_SERVICE_URL=http://qhkt-exam:8089
SEARCH_SERVICE_URL=http://qhkt-search:8083
BUSINESS_TIMEOUT_SECONDS=5
BUSINESS_MAX_RETRIES=2
MOCK_BUSINESS_MODE=false

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MEMORY_ENABLED=true
RATE_LIMIT_ENABLED=true
REQUESTS_PER_MINUTE=20
CONCURRENT_STREAMS=4
MESSAGES_PER_DAY=200

QDRANT_ENABLED=true
QDRANT_URL=http://qhkt-qdrant:6333
QDRANT_COLLECTION=course_knowledge_bge_small_zh_v15
QDRANT_API_KEY=
EMBEDDING_PROVIDER=HTTP
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BASE_URL=http://embedding-service:8000/v1
EMBEDDING_API_KEY_FILE=/run/secrets/embedding_api_key
EMBEDDING_TIMEOUT_SECONDS=20

RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=rerank-v1
RERANK_TIMEOUT_SECONDS=10
RERANK_TOP_N=8

ASR_ENABLED=false
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_TIMEOUT_SECONDS=60

RABBITMQ_URL=
MQ_ENABLED=true
KNOWLEDGE_INGESTION_USER_ID=7
INGESTION_WORKER_ENABLED=true

ADMIN_USER_IDS=7
ADMIN_ROLE_IDS=1
TEACHER_ROLE_IDS=3
PROMPT_VERSION=learning-agent-v1
PROMPT_KEY=learning-assistant
AI_INPUT_PRICE_MICROS=0
AI_OUTPUT_PRICE_MICROS=0
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY_FILE=/run/secrets/langsmith_api_key
LANGSMITH_PROJECT=qhkt-agent-prod
LANGSMITH_PRIVACY_MODE=true
MEDIA_SERVICE_URL=http://qhkt-media:8087
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_BUCKET=qhkt-agent
OBJECT_STORAGE_REGION=cn-hangzhou
AI_API_KEY_FILE=/run/secrets/ai_api_key
DATABASE_URL_FILE=/run/secrets/database_url
REDIS_PASSWORD_FILE=/run/secrets/redis_password
RABBITMQ_URL_FILE=/run/secrets/rabbitmq_url
QDRANT_API_KEY_FILE=/run/secrets/qdrant_api_key
LOG_LEVEL=INFO
