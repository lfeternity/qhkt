APP_ENV=development
HOST=0.0.0.0
PORT=8094
DATABASE_URL=sqlite+aiosqlite:///./qhkt-agent-python.db
DB_AUTO_CREATE=true

AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_MAX_TOOL_CALLS=4
AI_FALLBACK_ENABLED=true
AGENT_RUNTIME=langgraph
MAX_GRAPH_STEPS=12
GRAPH_NODE_TIMEOUT_SECONDS=45
GRAPH_CHECKPOINT_TTL_SECONDS=604800
MEMORY_CONTEXT_TOKEN_LIMIT=1000

JWT_ENABLED=false
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
TRUST_GATEWAY_HEADERS=true

COURSE_SERVICE_URL=http://localhost:8086
LEARNING_SERVICE_URL=http://localhost:8090
EXAM_SERVICE_URL=http://localhost:8089
SEARCH_SERVICE_URL=http://localhost:8083
BUSINESS_TIMEOUT_SECONDS=3
BUSINESS_MAX_RETRIES=1
MOCK_BUSINESS_MODE=true

REDIS_URL=
REDIS_PASSWORD=
REDIS_MEMORY_ENABLED=false
RATE_LIMIT_ENABLED=true
REQUESTS_PER_MINUTE=20
CONCURRENT_STREAMS=2
MESSAGES_PER_DAY=200

QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=course_knowledge_v1
QDRANT_API_KEY=
EMBEDDING_PROVIDER=LOCAL_HASH
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSION=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=20

RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=rerank-v1
RERANK_TIMEOUT_SECONDS=10
RERANK_TOP_N=8

ASR_ENABLED=false
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_TIMEOUT_SECONDS=60

RABBITMQ_URL=
MQ_ENABLED=false
KNOWLEDGE_INGESTION_USER_ID=1
INGESTION_WORKER_ENABLED=true

ADMIN_USER_IDS=1
ADMIN_ROLE_IDS=
TEACHER_ROLE_IDS=
PROMPT_VERSION=learning-agent-v1
PROMPT_KEY=learning-assistant
AI_INPUT_PRICE_MICROS=0
AI_OUTPUT_PRICE_MICROS=0
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qhkt-agent-dev
LANGSMITH_PRIVACY_MODE=true
MEDIA_SERVICE_URL=http://localhost:8087
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=qhkt-agent
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=cn-hangzhou
LOG_LEVEL=INFO
